# Copie para integracao-BI/.env.prod e preencha.
# DB_HOST / DB_WEBPOSTO_HOST / DB_BI_HOST / CLICKHOUSE_HOST / CLICKHOUSE_ENABLED / QUEUE_CONNECTION
# são sobrescritos pelo docker-compose.prod.yml - não precisa repetir aqui.

APP_NAME=Integracao-BI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://integracao-app:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=integracao_v1
DB_USERNAME=integracao
DB_PASSWORD=troque-esta-senha

DB_WEBPOSTO_PORT=3306
DB_WEBPOSTO_DATABASE=webposto
DB_WEBPOSTO_USERNAME=integracao
DB_WEBPOSTO_PASSWORD=troque-esta-senha

DB_BI_PORT=3306
DB_BI_DATABASE=bi
DB_BI_USERNAME=integracao
DB_BI_PASSWORD=troque-esta-senha

WEBPOSTO_CONNECT_TIMEOUT=5
WEBPOSTO_TIMEOUT=30

CLICKHOUSE_DATABASE=bi
CLICKHOUSE_USERNAME=bi_user
CLICKHOUSE_PASSWORD=troque-esta-senha
CLICKHOUSE_TIMEOUT=30
CLICKHOUSE_SYNC_BATCH=10000

LOG_CHANNEL=stack
LOG_LEVEL=warning
