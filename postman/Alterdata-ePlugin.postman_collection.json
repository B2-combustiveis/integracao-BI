{
  "info": {
    "_postman_id": "f9818588-c5cf-4f74-9cfb-422f0694daec",
    "name": "Alterdata ePlugin - Departamento Pessoal",
    "description": "Consultas somente leitura à API do eContador/Alterdata. Informe alterDataToken sem aspas e sem o prefixo Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{alterDataToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Resposta autorizada', function () {",
          "    pm.expect(pm.response.code).to.not.be.oneOf([401, 403]);",
          "});",
          "pm.test('Resposta JSON válida', function () {",
          "    pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dp.pack.alterdata.com.br/api/v1",
      "type": "string"
    },
    {
      "key": "alterDataToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "empresaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "funcionarioId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Empresas",
      "item": [
        {
          "name": "Listar todas as empresas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resposta = pm.response.json();",
                  "if (resposta.data && resposta.data.length) {",
                  "    pm.collectionVariables.set('empresaId', resposta.data[0].id);",
                  "}",
                  "pm.test('Total de empresas informado', function () {",
                  "    pm.expect(resposta.meta).to.have.property('totalResourceCount');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/empresas?page[limit]=100&page[offset]=0",
              "host": ["{{baseUrl}}"],
              "path": ["empresas"],
              "query": [
                { "key": "page[limit]", "value": "100" },
                { "key": "page[offset]", "value": "0" }
              ]
            },
            "description": "Lista as empresas disponíveis para o token e salva o primeiro ID em empresaId."
          },
          "response": []
        },
        {
          "name": "Consultar empresa por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/empresas/{{empresaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["empresas", "{{empresaId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Funcionários",
      "item": [
        {
          "name": "Listar funcionários",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resposta = pm.response.json();",
                  "if (resposta.data && resposta.data.length) {",
                  "    pm.collectionVariables.set('funcionarioId', resposta.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funcionarios?page[limit]=100&page[offset]=0&sort=codigo",
              "host": ["{{baseUrl}}"],
              "path": ["funcionarios"],
              "query": [
                { "key": "page[limit]", "value": "100" },
                { "key": "page[offset]", "value": "0" },
                { "key": "sort", "value": "codigo" }
              ]
            },
            "description": "Lista funcionários e salva o primeiro ID em funcionarioId."
          },
          "response": []
        },
        {
          "name": "Listar funcionários por empresa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funcionarios?filter[empresaId]={{empresaId}}&page[limit]=100&page[offset]=0&sort=codigo",
              "host": ["{{baseUrl}}"],
              "path": ["funcionarios"],
              "query": [
                { "key": "filter[empresaId]", "value": "{{empresaId}}" },
                { "key": "page[limit]", "value": "100" },
                { "key": "page[offset]", "value": "0" },
                { "key": "sort", "value": "codigo" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar funcionário por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/funcionarios?filter[id]={{funcionarioId}}&include=departamento,sexo,formadepagamento",
              "host": ["{{baseUrl}}"],
              "path": ["funcionarios"],
              "query": [
                { "key": "filter[id]", "value": "{{funcionarioId}}" },
                { "key": "include", "value": "departamento,sexo,formadepagamento" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Histórico",
      "item": [
        {
          "name": "Histórico de funções do funcionário",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/historico-funcoes?filter[funcionarioId]={{funcionarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["historico-funcoes"],
              "query": [
                { "key": "filter[funcionarioId]", "value": "{{funcionarioId}}" }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
